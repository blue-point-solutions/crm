# Backend base URL. The real backend is the erp repo's CRM mobile adapter,
# mounted under /mobile (see erp/docs/specs/crm-mobile.md).
#   Local dev:  erp `docker compose up db api` on this machine
#   Cloud dev:  always-on Contabo dev environment
EXPO_PUBLIC_API_URL=http://localhost:8000/mobile
# EXPO_PUBLIC_API_URL=https://erp-api.infobroker.tech/mobile
